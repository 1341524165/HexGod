<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="hexgod · 本地战术助手" Width="1180" Height="840" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#E9EEF8" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#22314A"/><Setter Property="Foreground" Value="#E9EEF8"/>
      <Setter Property="BorderBrush" Value="#334460"/><Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1627"/><Setter Property="Foreground" Value="#E9EEF8"/>
      <Setter Property="BorderBrush" Value="#334460"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#76EDC4"/>
      <Setter Property="SelectionBrush" Value="#276D61"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172337"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Cell" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Padding="11,10"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="#1B2940"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="Background" Value="#183A37"/><Setter TargetName="Cell" Property="BorderBrush" Value="#368F78"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Border BorderBrush="#202C42" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#73EDC2" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0"><TextBlock Text="H" Foreground="#0E2823" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel><TextBlock Text="HEXGOD" FontSize="18" FontWeight="Bold"/><TextBlock Text="海克斯大乱斗 · 本地战术助手" Foreground="#92A1BC" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
            <TextBlock Name="DataBadge" Text="载入本地数据…" Foreground="#91A2BF"/>
            <TextBlock Name="SessionBadge" Text="对局状态 · 等待游戏" Foreground="#73C6AA" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <Button Name="OverlayButton" Content="打开悬浮窗" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="22,20,22,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="222"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#121B2C" CornerRadius="12" BorderBrush="#223048" BorderThickness="1" Padding="13">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="3,3,0,15"><TextBlock Text="选择你的英雄" FontWeight="Bold" FontSize="16"/><TextBlock Name="HeroCount" Text="按样本胜率排列" FontSize="11" Foreground="#8B9AB5" Margin="0,5,0,0"/></StackPanel>
          <TextBox Name="HeroSearch" Grid.Row="1" ToolTip="搜索称号、姓名或英文名" Margin="0,0,0,12"/>
          <ListBox Name="HeroList" Grid.Row="2" Background="Transparent" Foreground="#E9EEF8" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></ListBox.Template>
          </ListBox>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel>
          <Border Background="#142235" BorderBrush="#2A3E57" BorderThickness="1" CornerRadius="12" Padding="21,17" Margin="0,0,0,17">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="当前英雄" Foreground="#8DA6C3" FontSize="11"/><TextBlock Name="HeroTitle" Text="正在载入…" FontSize="29" FontWeight="Bold" Margin="0,5,0,3"/>
                <TextBlock Name="HeroSubtitle" Text="选择英雄后，查看适配的强化与装备。" Foreground="#9EAEC5" FontSize="12"/></StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Name="HeroWinRate" Text="—" FontSize="32" Foreground="#77EAC2" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="英雄样本胜率" FontSize="11" Foreground="#94A6BE" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
          </Border>
          <Border Background="#142235" BorderBrush="#2A3E57" BorderThickness="1" CornerRadius="10" Padding="15,12" Margin="0,0,0,18">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="自动识别与记录" FontSize="15" FontWeight="Bold"/>
                <Button Name="ClearOwnedButton" Visibility="Collapsed" Grid.Column="1" Content="新的一局 / 清空" Padding="10,5" Margin="0"/>
                <Button Name="LogButton" Grid.Column="1" Content="打开本局日志" Padding="10,5" Margin="0"/>
              </Grid>
              <TextBlock Name="OwnedSummary" Text="尚未记录。游戏内正常点击海克斯后会尝试自动记入；也可手动添加。" Foreground="#AFC0D4" Margin="0,8,0,8" TextWrapping="Wrap"/>
              <WrapPanel Name="OwnedChips" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                <ComboBox Name="OwnedPicker" Width="223" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,8,0"/>
                <Button Name="AddOwnedButton" Content="添加已选" Padding="11,6"/>
              </StackPanel>
              <TextBlock Name="OwnedDataStatus" Text="记录已选后，将检查联动样本并更新出装方向。" Foreground="#8DA8C3" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="强化三选一" FontSize="21" FontWeight="Bold"/><TextBlock Name="ResultMeta" Grid.Column="1" Text="等待识别" Foreground="#8FA0BA" VerticalAlignment="Center" FontSize="11"/>
          </Grid>
          <TextBlock Text="按屏幕从左到右展示，绿色标出 ARAMGG 排名优先项；胜率样本版本单独注明。" Foreground="#8FA0BA" FontSize="12" Margin="0,0,0,15"/>
          <WrapPanel Margin="0,0,0,10">
            <Button Name="CaptureButton" Content="识别游戏画面" Background="#70E4BC" Foreground="#0C2A23" BorderBrush="#70E4BC"/>
            <Button Name="ImportButton" Content="导入截图"/><Button Name="AutoButton" Content="开始自动识别与记录"/><Button Name="DemoButton" Content="体验示例" Margin="0"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><TextBlock Text="自动适配游戏窗口与屏幕缩放" Foreground="#90A0B9" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Name="PresetCombo" Width="173" Visibility="Collapsed"/>
            <TextBlock Text="Ctrl + Alt + H 识别 · Ctrl + Alt + O 浮窗" Foreground="#7187A7" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
          <UniformGrid Name="ChoiceCards" Columns="3" Margin="0,0,0,13"/>
          <Border Background="#101D2D" CornerRadius="8" Padding="12,10" Margin="0,0,0,13"><TextBlock Name="StatusText" Text="正在连接本地识别服务…" TextWrapping="Wrap" Foreground="#A7B9D1" FontSize="12"/></Border>
          <Expander Name="ManualPanel" Visibility="Collapsed" Header="离线调试" Foreground="#AEBDD2" Margin="0,0,0,20">
            <StackPanel Margin="0,12,0,0"><UniformGrid Columns="3">
              <ComboBox Name="Manual1" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,8,0"/>
              <ComboBox Name="Manual2" IsEditable="True" IsTextSearchEnabled="True" Margin="0,0,8,0"/>
              <ComboBox Name="Manual3" IsEditable="True" IsTextSearchEnabled="True"/>
            </UniformGrid><Button Name="RankButton" Content="比较这三项" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
          </Expander>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="装备推荐" FontSize="20" FontWeight="Bold"/><TextBlock Text="每栏最多三件 · 自行选择购买" Foreground="#8FA0BA" FontSize="11" Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <Border Background="#162238" CornerRadius="8" Padding="13" Margin="0,0,8,12"><TextBlock Name="BuildPath" Text="正在载入出装参考…" Foreground="#ABC3E3" FontSize="12" LineHeight="23" TextWrapping="Wrap"/></Border>
          <TextBlock Text="常规装备" Foreground="#BAC8DC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
          <UniformGrid Name="ItemCards" Columns="3" Margin="0,0,0,18"/>
          <StackPanel Name="SynergyItemSection" Visibility="Collapsed">
            <TextBlock Text="海克斯联动" Foreground="#9AD8BB" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <UniformGrid Name="SynergyItemCards" Columns="3" Margin="0,0,0,18"/>
          </StackPanel>
          <TextBlock Text="该英雄的常见优选强化（单项统计）" Foreground="#BAC8DC" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
          <WrapPanel Name="TopAugments" Margin="0,0,0,20"/>
          <TextBlock Text="基于随包本地统计数据。显示数据版本与样本量，建议结合当前对局判断。" Foreground="#637B9B" FontSize="11" Margin="0,0,0,20"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Name="FooterText" Text="本地运行 · OCR 与推荐均在本机完成" Foreground="#6983A3" FontSize="10" VerticalAlignment="Center"/>
      <TextBlock Text="REBUILD  0.17" Grid.Column="1" Foreground="#6983A3" FontSize="10" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
